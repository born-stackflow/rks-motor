# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# claude code local tool state
.claude

# typescript
*.tsbuildinfo
next-env.d.ts

# graphify
.graphify/

# claude code: local state and agent documentation
.claude/
CLAUDE.md
CLAUDE.local.md
**/CLAUDE.md
**/CLAUDE.local.md

# secrets pulled from vercel (not covered by .env*)
env.download

# vendor handoff notes (contain personal data)
DEPLOYMENT_NOTES.md

# playwright mcp output
.playwright-mcp/

# lighthouse ci reports
.lighthouseci/
