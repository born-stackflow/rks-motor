# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://rks-motorcycles.com
NODE_ENV=production

# ── Sanity CMS ────────────────────────────────────────────────────────────────
# Get these from https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
# Read-write token for server-side mutations (enquiry form submissions etc.)
SANITY_API_TOKEN=your_sanity_api_token
SANITY_STUDIO_URL=https://rks-motorcycles.sanity.studio

# ── Resend Email ──────────────────────────────────────────────────────────────
# https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@rks-motorcycles.com

# ── Email Recipients ──────────────────────────────────────────────────────────
TEAM_NOTIFICATION_EMAIL=team@rks-motorcycles.com
SALES_TEAM_EMAIL=sales@rks-motorcycles.com
PARTS_TEAM_EMAIL=parts@rks-motorcycles.com
TRADE_TEAM_EMAIL=trade@rks-motorcycles.com
SUPPORT_EMAIL=support@rks-motorcycles.com

# ── Google Maps ───────────────────────────────────────────────────────────────
# Required for interactive dealer map
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ── Analytics ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# ── Security ──────────────────────────────────────────────────────────────────
# CORS — add all domains that may call the API routes
ALLOWED_ORIGINS=https://rks-motorcycles.com,https://www.rks-motorcycles.com

# Rate limiting for enquiry API routes
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000

# ── ERP Integration (Future) ──────────────────────────────────────────────────
# Uncomment when Zucchetti ERP integration is ready
# ZUCCHETTI_API_ENDPOINT=https://api.zucchetti.com/endpoint
# ZUCCHETTI_API_TOKEN=your_zucchetti_api_token
# ZUCCHETTI_COMPANY_ID=your_company_id

# ── Optional Payments ─────────────────────────────────────────────────────────
# Uncomment if implementing direct online sales
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxx
# STRIPE_SECRET_KEY=sk_live_xxxxxxxxxx
