# ── Site ──────────────────────────────────────────────────────────────────────
# Public URL used for canonical links, sitemap, robots and email links
NEXT_PUBLIC_SITE_URL=https://rksitalia.it
# Extra origins allowed to post the public forms (comma separated, optional)
ALLOWED_ORIGINS=

# ── Sanity CMS ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=f3zi3siz
NEXT_PUBLIC_SANITY_DATASET=production
# Token with write access, used only by the form API routes and the invoice route
SANITY_API_TOKEN=
# Defaults to <NEXT_PUBLIC_SITE_URL>/studio
SANITY_STUDIO_URL=

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "RKS <noreply@rksitalia.it>"
RESEND_FROM_EMAIL=
# Optional: newsletter sign-ups are added to this Resend segment instead of emailed to the team
RESEND_SEGMENT_ID=

# Fallback recipients. Studio → Site Settings → Contact takes precedence.
TEAM_NOTIFICATION_EMAIL=
SALES_TEAM_EMAIL=
TRADE_TEAM_EMAIL=
PARTS_TEAM_EMAIL=

# ── Internal ──────────────────────────────────────────────────────────────────
# Enables POST /api/generate-invoice (Authorization: Bearer <secret>); unset = disabled
INVOICE_API_SECRET=
